@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">ASP.NET</h1>
        <p class="lead">Wellcom to the Recycling Rewards app; an app that rewards you for helping in saving our planet. 
                        Already a user? Click the button bellow to Login</p>
        <p><a href="https://localhost:44332/Account/Login">Login &raquo;</a></p>

        <p class="lead">If your a new user click the button bellow to register</p>
        <p><a href="https://localhost:44332/Account/Register">Register &raquo;</a></p>
    </section>
    
    <div class="row">
        <section class="col-md-4" aria-labelledby="DropOffPointsTitle">
            <h2 id="DropOffPointsTitle">Our Drop Off Points</h2>
            <p>
            to see the locations that will serve as the drop off/ collection point for your recycled materials.
            </p>
            <p><a class="btn btn-outline-dark" href="https://localhost:44332/DropOffPoints/Index">Click Here &raquo;</a></p>
        </section>

