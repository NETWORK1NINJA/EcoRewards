@model IEnumerable<EcoRewards.Models.MaterialType>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsActive)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PointsPerKg)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CO2PerKg)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsActive)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PointsPerKg)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CO2PerKg)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.MaterialTypeId }) |
            @Html.ActionLink("Details", "Details", new { id=item.MaterialTypeId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.MaterialTypeId })
        </td>
    </tr>
}

</table>
